{
  "name": "lghs-local",
  "version": "0.1.0",
  "private": true,
  "description": "Leonhart's Game Hosting System Local — Discord-controlled game host",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/console/public','dist/console/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dockerode": "^4.0.7",
    "dotenv": "^16.6.1",
    "rcon-client": "^4.2.5",
    "tar": "^7.4.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
